CCannedObject
{
	Object=CAddCharacterModifierToCharacterAction
	{
		Modifier Description=Playtest Kit
		Modification is permanent=1
		Character to modify=Player#1-9#
		Modifiers=Array
		{
			Item Count=1
			Modifier=CCharacterModifierDerivedAttribute
			{
				Modification Amount=CConstant
				{
					Constant Value=1
				}
				Modification amount is a percent=0
				Allow Accumulation=1
				Derived character attribute to modify=Derived Character Attributes/Uber Perks/Goblin Rank
			}
		}
		OPTIONAL Duration=
		Expression Context=$Instigator
	}
	Use=Shared Global Instance
}
